<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".NextUpApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NextUp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NextUp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.DeadlineReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vinish.nextup.ACTION_SHOW_REMINDER" />
                <action android:name="com.vinish.nextup.ACTION_MARK_DONE" />
                <action android:name="com.vinish.nextup.ACTION_SNOOZE" />
                <action android:name="com.vinish.nextup.ACTION_AUTOFILL_ADD" />
                <action android:name="com.vinish.nextup.ACTION_DISMISS_SUGGESTION" />
            </intent-filter>
        </receiver>

        <!-- Background Service for detecting deadlines from incoming notifications -->
        <service
            android:name=".notifications.DeadlineNotificationListenerService"
            android:label="NextUp Smart Deadline Capture"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>